{
  "name": "roku-remote",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "test": "vitest run --coverage",
    "android:lint": "cd src-tauri/gen/android && ./gradlew :app:lintArm64Debug -x rustBuildArm64Debug",
    "android:test": "cd src-tauri/gen/android && ./gradlew :app:testArm64DebugUnitTest -x rustBuildArm64Debug",
    "release": "node scripts/release.mjs",
    "test:scripts": "node --test scripts/release/lib.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-os": "~2.4.0",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
