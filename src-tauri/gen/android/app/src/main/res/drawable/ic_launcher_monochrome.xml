    <path
        android:pathData="M44.5,35.5Q54,28.5 63.5,35.5M48.5,40Q54,36 59.5,40"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <!-- TV outline, open where the remote overlaps it -->
    <path
        android:pathData="M41,68H30V44H78V68H67"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
