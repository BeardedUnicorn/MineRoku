{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roku Remote",
  "version": "../package.json",
  "identifier": "com.rokucontroller.remote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "Roku Remote",
        "label": "main",
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "width": 1000,
        "height": 750,
        "decorations": true,
        "center": true,
        "backgroundColor": "#150F26",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMDg5MjQ5REYyODVCRDQKUldUVVd5amZTWklJTHhJSGZlWUVxNkptZDVkaU5Zd1JLZlFtdEJYcGIzcDlZSC9Bd2J3THduL0EK",
      "endpoints": ["https://github.com/BeardedUnicorn/MineRoku/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
