{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roku Remote",
  "version": "0.1.0",
  "identifier": "com.rokucontroller.remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "Roku Remote",
        "label": "main",
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "width": 1000,
        "height": 750,
        "decorations": true,
        "center": true,
        "backgroundColor": "#121212",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
